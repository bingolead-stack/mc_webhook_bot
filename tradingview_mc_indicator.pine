
 //@version=6
indicator("MC Candle — 4H Alert", overlay=true)

// ==========================================
// SETTINGS
// ==========================================

biasBars = input.int(18, "Bias Period (4H Candles)", minval=2)

enableBull = input.bool(true, "Enable Bullish Alerts")
enableBear = input.bool(true, "Enable Bearish Alerts")
showBias = input.bool(false, "Show Bias Background")

// ==========================================
// MARKET BIAS
// ==========================================

// Only operate on 4-hour charts
is4H = timeframe.isminutes and timeframe.multiplier == 240

// Require sufficient history and candle confirmation
ready = is4H and not na(close[biasBars]) and barstate.isconfirmed

// Compare first and last closes of previous 18 candles
bullBias = ready and close[1] > close[biasBars]
bearBias = ready and close[1] < close[biasBars]

// ==========================================
// CANDLE DIRECTIONS
// ==========================================

// Current candle direction
currentBull = close > open
currentBear = close < open

// Previous candle direction
previousBull = close[1] > open[1]
previousBear = close[1] < open[1]

// ==========================================
// MC CANDLE DETECTION
// ==========================================

// BULLISH MC CONDITIONS:
// 1. Bullish market bias
// 2. Previous candle is bullish
// 3. Current candle is bullish
// 4. Current low breaks previous low
// 5. Current close exceeds previous candle body

bullMC = bullBias and
     previousBull and
     currentBull and
     low < low[1] and
     close > math.max(open[1], close[1])

// BEARISH MC CONDITIONS:
// 1. Bearish market bias
// 2. Previous candle is bearish
// 3. Current candle is bearish
// 4. Current high breaks previous high
// 5. Current close falls below previous candle body

bearMC = bearBias and
     previousBear and
     currentBear and
     high > high[1] and
     close < math.min(open[1], close[1])

// ==========================================
// CHART LABELS
// ==========================================

plotshape(
     bullMC,
     title="Bullish MC",
     style=shape.labelup,
     location=location.belowbar,
     offset=0,
     color=color.lime,
     text="MC BUY",
     textcolor=color.black,
     size=size.tiny)

plotshape(
     bearMC,
     title="Bearish MC",
     style=shape.labeldown,
     location=location.abovebar,
     offset=0,
     color=color.red,
     text="MC SELL",
     textcolor=color.white,
     size=size.tiny)

// ==========================================
// MARKET BIAS BACKGROUND
// ==========================================

bgcolor(
     showBias and bullBias ? color.new(color.green, 93) :
     showBias and bearBias ? color.new(color.red, 93) :
     na)

// ==========================================
// TRADINGVIEW ALERT CONDITIONS
// ==========================================

alertcondition(
     enableBull and bullMC,
     title="Bullish MC",
     message="Bullish MC detected on {{ticker}} | 4H | Close: {{close}}")

alertcondition(
     enableBear and bearMC,
     title="Bearish MC",
     message="Bearish MC detected on {{ticker}} | 4H | Close: {{close}}")

// ==========================================
// COMBINED WEBHOOK ALERT
// ==========================================

if (enableBull and bullMC) or (enableBear and bearMC)

    direction = bullMC ? "bullish" : "bearish"

    message = '{"event":"mc_candle",' +
         '"symbol":"' + syminfo.tickerid + '",' +
         '"direction":"' + direction + '",' +
         '"timeframe":"4h",' +
         '"open":' + str.tostring(open, format.mintick) + ',' +
         '"high":' + str.tostring(high, format.mintick) + ',' +
         '"low":' + str.tostring(low, format.mintick) + ',' +
         '"close":' + str.tostring(close, format.mintick) +
         '}'

    alert(message, alert.freq_once_per_bar_close)
